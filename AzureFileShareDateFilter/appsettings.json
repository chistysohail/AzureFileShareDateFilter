{
  "AzureFileShare": {
    "ConnectionString": "",
    "ShareName": "application-files",
    "EnableDateFilter": false,
    "StartDate": "2026-10-01",
    "EndDate": "2026-10-12",
    "Recursive": true,
    "DirectoryPaths": [
      "inbound/2026",
      "outbound/reports",
      "archive/monthly",
      "logs"
    ]
  },
  "Operation": {
    "Mode": "List",
    "DownloadDirectory": "C:/AzureDownloads",
    "PreserveFolderStructure": true,
    "OverwriteExisting": false,
    "MaxConcurrentDownloads": 8
  },
  "Output": {
    "SaveToFile": true,
    "Directory": "C:/AzureReports"
  }
}
